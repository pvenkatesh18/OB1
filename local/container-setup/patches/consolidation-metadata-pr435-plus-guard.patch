+/**
+ * True when a thought has no usable confidence score: absent, blank, or a
+ * numeric value below the 0.7 review threshold.
+ */
+function hasWeakConfidence(metadata: Record<string, unknown>): boolean {
+  const raw = metadata.confidence;
+  if (raw === undefined || raw === null || raw === "") return true;
+  const parsed = Number(raw);
+  if (!Number.isFinite(parsed)) return true;
+  return parsed < 0.7;
+}
